{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "src/**/*.mjs"],
  "exclude": ["src/**/*.test.ts", "src/test-setup.ts", "src/test-fixture.ts", "src/gen/test-helpers/**"]
}
