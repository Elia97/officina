{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

  // Ogni comando lo carica bin.ts con un import dinamico, che fallow non traccia, e il plopfile
  // lo carica plop. Esportano tutti `main` di proposito, è il contratto che bin.ts chiama.
  "entry": [
    "src/index.ts",
    "src/smoke.ts",
    "src/bundle.ts",
    "src/icons.ts",
    "src/checks/*.ts",
    "src/gen/run.ts",
    "src/gen/icons.ts",
    "src/gen/plopfile.mjs"
  ],
  // Dati di prova letti dal disco dai test, non codice del pacchetto.
  "ignorePatterns": ["test/fixture-project/**"]
}
